{
  "name": "applet",
  "version": "1.0.0",
  "description": "Compare a learner’s current profile with a target role and create a roadmap linking skill gaps to learning, projects, milestones, and employability evidence.",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "generate:types": "openapi-typescript ./public/openapi.json -o ./src/api/schema.d.ts",
    "start": "tsx server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@hookform/resolvers": "3.9.0",
    "@tanstack/react-query": "5.56.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "i18next": "23.15.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "0.441.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.0",
    "react-i18next": "15.0.2",
    "react-router-dom": "6.26.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.47.2",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "18.3.10",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "autoprefixer": "10.4.20",
    "axe-core": "4.10.0",
    "jsdom": "25.0.1",
    "msw": "2.4.9",
    "openapi-typescript": "7.4.2",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "tsx": "^4.23.15",
    "typescript": "5.6.2",
    "vite": "5.4.8",
    "vitest": "2.1.1"
  }
}
