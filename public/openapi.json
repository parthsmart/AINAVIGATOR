            }
          }
        }
      },
      "put": {
        "operationId": "save_answers_put_v1_assessment_answers_put",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SaveAnswersRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
